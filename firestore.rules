rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPackageSender() {
      return signedIn() && resource.data.senderUid == request.auth.uid;
    }

    function isPackageRecipient() {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.recipientEmailLower == request.auth.token.email;
    }

    function validTeacherGradePackageCreate(transferId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'id',
          'importedAt',
          'packageData',
          'recipientEmailLower',
          'senderEmail',
          'senderName',
          'senderUid',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == transferId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.recipientEmailLower is string
        && request.resource.data.status == 'sent'
        && request.resource.data.importedAt == ''
        && request.resource.data.packageData.schema == "avaluapro.teacher-grade-package"
        && request.resource.data.packageData.version == 1
        && request.resource.data.packageData.keys().hasOnly([
          'createdAt',
          'id',
          'schema',
          'sender',
          'source',
          'students',
          'summary',
          'version'
        ])
        && request.resource.data.packageData.id == transferId
        && request.resource.data.packageData.sender.keys().hasOnly(['email', 'name', 'uid'])
        && request.resource.data.packageData.sender.uid == request.auth.uid
        && request.resource.data.packageData.sender.email == request.auth.token.email
        && request.resource.data.packageData.source.keys().hasOnly(['classId', 'className', 'subject'])
        && request.resource.data.packageData.source.classId is string
        && request.resource.data.packageData.source.className is string
        && request.resource.data.packageData.source.subject is string
        && request.resource.data.packageData.students is list
        && request.resource.data.packageData.summary.keys().hasOnly([
          'competencyCount',
          'emptyCount',
          'gradeCount',
          'studentCount',
          'trackingStudentCount'
        ]);
    }

    function validTeacherGradePackageImportUpdate() {
      return isPackageRecipient()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'importedByEmail',
          'importedByUid',
          'importedAt',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status == 'imported'
        && request.resource.data.importedByEmail == request.auth.token.email
        && request.resource.data.importedByUid == request.auth.uid
        && request.resource.data.importedAt is string
        && request.resource.data.updatedAt is string;
    }

    function isTutoringSpaceMember() {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in resource.data.memberEmails
          )
          || (
            resource.data.memberUids is list
            && request.auth.uid in resource.data.memberUids
          )
        );
    }

    function isTutoringSpaceOwner() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.ownerEmailLower == request.auth.token.email
          )
        );
    }

    function isTutoringSpaceMemberAfterWrite() {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in request.resource.data.memberEmails
          )
          || (
            request.resource.data.memberUids is list
            && request.auth.uid in request.resource.data.memberUids
          )
        );
    }

    function tutoringMembersUnchanged() {
      return request.resource.data.memberEmails == resource.data.memberEmails
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.members == resource.data.members;
    }

    function isAllowedTutoringCollection(collectionName) {
      return collectionName in [
        'students',
        'agendaNotes',
        'studentAntecedents',
        'tutorialGroupSets',
        'tutorialMarks',
        'tutorialRecords',
        'tutorialRelations',
        'tutorialSeatingPlans',
        'tutorialSociogramLayouts',
        'tutorialSociometricMoments',
        'tutorialStudentRoles'
      ];
    }

    function canAccessTutoringSpace(spaceId) {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberEmails
          )
          || (
            get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberUids is list
            && request.auth.uid in get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberUids
          )
        );
    }

    function validTutoringSpaceCreate(spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'lastSharedConflictAt',
          'memberEmails',
          'memberUids',
          'members',
          'ownerEmailLower',
          'ownerUid',
          'sharedConflictSummary',
          'sharedSummary',
          'sourceClassId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == spaceId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmailLower == request.auth.token.email
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.auth.token.email in request.resource.data.memberEmails
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.members is list
        && request.resource.data.status == 'active';
    }

    function validTutoringSpaceOwnerUpdate() {
      return isTutoringSpaceOwner()
        && isTutoringSpaceMemberAfterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'className',
          'createdAt',
          'id',
          'lastSharedConflictAt',
          'memberEmails',
          'memberUids',
          'members',
          'ownerEmailLower',
          'ownerUid',
          'sharedConflictSummary',
          'sharedSummary',
          'sourceClassId',
          'status',
          'updatedAt'
        ])
        && (
          !resource.data.keys().hasAny(['id'])
          || request.resource.data.id == resource.data.id
        )
        && (
          !resource.data.keys().hasAny(['ownerUid'])
          || request.resource.data.ownerUid == resource.data.ownerUid
        )
        && (
          !resource.data.keys().hasAny(['ownerEmailLower'])
          || request.resource.data.ownerEmailLower == resource.data.ownerEmailLower
        )
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.resource.data.members is list
        && request.resource.data.status == 'active';
    }

    function validTutoringSpaceMemberSyncUpdate() {
      return isTutoringSpaceMember()
        && tutoringMembersUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSharedConflictAt',
          'sharedConflictSummary',
          'sharedSummary',
          'updatedAt'
        ])
        && request.resource.data.status == 'active';
    }

    function hasAcceptedTutoringInvitation(spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/tutoringInvitationInbox/$(request.auth.token.email)/items/$(spaceId))
        && get(/databases/$(database)/documents/tutoringInvitationInbox/$(request.auth.token.email)/items/$(spaceId)).data.status == 'accepted';
    }

    function validTutoringSpaceInvitationAccept(spaceId) {
      return hasAcceptedTutoringInvitation(spaceId)
        && isTutoringSpaceMemberAfterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberEmails',
          'memberUids',
          'members',
          'updatedAt'
        ])
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.resource.data.members is list
        && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.token.email in request.resource.data.memberEmails
        && request.auth.uid in request.resource.data.memberUids;
    }

    function validTutoringSpaceSelfLeave() {
      return isTutoringSpaceMember()
        && !isTutoringSpaceOwner()
        && request.auth.token.email is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberEmails',
          'memberUids',
          'members',
          'updatedAt'
        ])
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.resource.data.members is list
        && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() - 1
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.memberEmails.hasAll(request.resource.data.memberEmails)
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && resource.data.members.hasAll(request.resource.data.members)
        && !(request.auth.token.email in request.resource.data.memberEmails)
        && !(request.auth.uid in request.resource.data.memberUids);
    }

    function isTutoringInvitationRecipient(recipientEmailLower) {
      return signedIn()
        && request.auth.token.email is string
        && recipientEmailLower == request.auth.token.email;
    }

    function isTutoringInvitationSender() {
      return signedIn() && resource.data.senderUid == request.auth.uid;
    }

    function validTutoringInvitationCreate(recipientEmailLower, spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'outboxId',
          'recipientEmailLower',
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'senderEmail',
          'senderEmailLower',
          'senderName',
          'senderSeenAt',
          'senderUid',
          'sourceClassId',
          'spaceId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == spaceId
        && request.resource.data.spaceId == spaceId
        && request.resource.data.recipientEmailLower == recipientEmailLower
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmailLower == request.auth.token.email
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == ''
        && request.resource.data.responseByEmail == ''
        && request.resource.data.responseByUid == ''
        && request.resource.data.senderSeenAt == '';
    }

    function validTutoringInvitationOutboxCreate(senderUid, outboxId) {
      return signedIn()
        && request.auth.token.email is string
        && senderUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'outboxId',
          'recipientEmailLower',
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'senderEmail',
          'senderEmailLower',
          'senderName',
          'senderSeenAt',
          'senderUid',
          'sourceClassId',
          'spaceId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.outboxId == outboxId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmailLower == request.auth.token.email
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.recipientEmailLower is string
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == ''
        && request.resource.data.responseByEmail == ''
        && request.resource.data.responseByUid == ''
        && request.resource.data.senderSeenAt == '';
    }

    function validTutoringInvitationOutboxRecipientResponse() {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.recipientEmailLower == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'status',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.responseByEmail == request.auth.token.email
        && request.resource.data.responseByUid == request.auth.uid
        && request.resource.data.respondedAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationOutboxSenderAck(senderUid) {
      return signedIn()
        && senderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'senderSeenAt',
          'updatedAt'
        ])
        && request.resource.data.senderSeenAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationRecipientResponse(recipientEmailLower) {
      return isTutoringInvitationRecipient(recipientEmailLower)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'status',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.responseByEmail == request.auth.token.email
        && request.resource.data.responseByUid == request.auth.uid
        && request.resource.data.respondedAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationSenderAck() {
      return isTutoringInvitationSender()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'senderSeenAt',
          'updatedAt'
        ])
        && request.resource.data.senderSeenAt is string
        && request.resource.data.updatedAt is string;
    }

    function isSociometricSurveyOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isSociometricSurveyMember() {
      return signedIn()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
    }

    function canAccessSociometricSurvey() {
      return isSociometricSurveyOwner() || isSociometricSurveyMember();
    }

    function canAccessSociometricSurveyById(surveyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sociometricSurveys/$(surveyId))
        && (
          get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.ownerUid == request.auth.uid
          || (
            get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.memberUids is list
            && request.auth.uid in get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.memberUids
          )
        );
    }

    function activeSociometricSurveyById(surveyId) {
      return exists(/databases/$(database)/documents/sociometricSurveys/$(surveyId))
        && get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.status == 'active'
        && get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.expiresAtEpochMs is number
        && request.time.toMillis()
          < get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.expiresAtEpochMs;
    }

    function validSociometricSurveyCreate(surveyId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'avoidLimit',
          'classId',
          'className',
          'createdAt',
          'expiresAt',
          'expiresAtEpochMs',
          'id',
          'importedRelationCount',
          'lastSyncedAt',
          'memberUids',
          'ownerEmailLower',
          'ownerUid',
          'positiveLimit',
          'responseCount',
          'status',
          'studentOptionIds',
          'studentOptions',
          'updatedAt'
        ])
        && request.resource.data.id == surveyId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmailLower == request.auth.token.email
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.status in ['active', 'closed']
        && request.resource.data.classId is string
        && request.resource.data.className is string
        && request.resource.data.studentOptionIds is list
        && request.resource.data.studentOptions is list
        && request.resource.data.studentOptionIds.size() > 0
        && request.resource.data.studentOptions.size() == request.resource.data.studentOptionIds.size()
        && request.resource.data.positiveLimit is number
        && request.resource.data.avoidLimit is number
        && request.resource.data.responseCount == 0
        && request.resource.data.importedRelationCount == 0
        && request.resource.data.lastSyncedAt == ''
        && request.resource.data.createdAt is string
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number
        && request.resource.data.expiresAtEpochMs > request.time.toMillis()
        && request.resource.data.updatedAt is string;
    }

    function validSociometricSurveyUpdate() {
      return canAccessSociometricSurvey()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'importedRelationCount',
          'lastSyncedAt',
          'responseCount',
          'expiresAt',
          'expiresAtEpochMs',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status in ['active', 'closed']
        && request.resource.data.responseCount is number
        && request.resource.data.importedRelationCount is number
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number
        && request.resource.data.updatedAt is string;
    }

    function validSociometricAccessTokenCreate(surveyId, tokenId) {
      let survey = getAfter(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data;
      return signedIn()
        && survey.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'avoidLimit',
          'classId',
          'className',
          'createdAt',
          'expiresAt',
          'expiresAtEpochMs',
          'positiveLimit',
          'privacyNoticeVersion',
          'studentId',
          'studentName',
          'studentOptions',
          'surveyId',
          'tokenId'
        ])
        && request.resource.data.tokenId == tokenId
        && request.resource.data.surveyId == surveyId
        && request.resource.data.studentId in survey.studentOptionIds
        && request.resource.data.studentName is string
        && request.resource.data.classId == survey.classId
        && request.resource.data.className == survey.className
        && request.resource.data.studentOptions == survey.studentOptions
        && request.resource.data.positiveLimit == survey.positiveLimit
        && request.resource.data.privacyNoticeVersion is string
        && request.resource.data.avoidLimit == survey.avoidLimit
        && request.resource.data.createdAt == survey.createdAt
        && request.resource.data.expiresAt == survey.expiresAt
        && request.resource.data.expiresAtEpochMs == survey.expiresAtEpochMs;
    }

    function validSociometricAccessTokenUpdate(surveyId) {
      return canAccessSociometricSurveyById(surveyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expiresAt',
          'expiresAtEpochMs'
        ])
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number;
    }

    function validSociometricAccessTokenRead(surveyId, tokenId) {
      return activeSociometricSurveyById(surveyId)
        && resource.data.tokenId == tokenId
        && resource.data.surveyId == surveyId
        && resource.data.expiresAtEpochMs is number
        && request.time.toMillis() < resource.data.expiresAtEpochMs;
    }

    function validSociometricResponseWrite(surveyId, responseId) {
      let token = get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)/accessTokens/$(responseId)).data;
      return activeSociometricSurveyById(surveyId)
        && request.resource.data.keys().hasOnly([
          'accessToken',
          'avoidStudentIds',
          'classId',
          'positiveStudentIds',
          'privacyNoticeAcknowledged',
          'privacyNoticeVersion',
          'responseId',
          'studentId',
          'studentName',
          'submittedAt',
          'surveyId'
        ])
        && request.resource.data.responseId == responseId
        && request.resource.data.accessToken == responseId
        && request.resource.data.surveyId == surveyId
        && request.resource.data.classId == get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.classId
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && token.tokenId == responseId
        && token.studentId == request.resource.data.studentId
        && token.studentName == request.resource.data.studentName
        && token.expiresAtEpochMs is number
        && request.time.toMillis() < token.expiresAtEpochMs
        && request.resource.data.studentId in get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.studentOptionIds
        && request.resource.data.positiveStudentIds is list
        && request.resource.data.avoidStudentIds is list
        && request.resource.data.privacyNoticeAcknowledged == true
        && request.resource.data.privacyNoticeVersion == token.privacyNoticeVersion
        && request.resource.data.positiveStudentIds.size() <= get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.positiveLimit
        && request.resource.data.avoidStudentIds.size() <= get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.avoidLimit
        && request.resource.data.submittedAt is string;
    }

    function isStudentProfileSurveyMember() {
      return signedIn()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
    }

    function canListStudentProfileSurvey() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            resource.data.memberUidMap is map
            && resource.data.memberUidMap[request.auth.uid] == true
          )
        );
    }

    function isStudentProfileSurveyOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function canAccessStudentProfileSurveyById(surveyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/studentProfileSurveys/$(surveyId))
        && get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.memberUids is list
        && request.auth.uid in get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.memberUids;
    }

    function activeStudentProfileSurveyById(surveyId) {
      return exists(/databases/$(database)/documents/studentProfileSurveys/$(surveyId))
        && get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.status == 'active'
        && get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.expiresAtEpochMs is number
        && request.time.toMillis()
          < get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.expiresAtEpochMs;
    }

    function validStudentProfileSurveyCreate(surveyId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'academicYear',
          'classId',
          'className',
          'createdAt',
          'expiresAt',
          'expiresAtEpochMs',
          'formVersion',
          'id',
          'memberUidMap',
          'memberUids',
          'ownerUid',
          'privacyNoticeVersion',
          'responseCount',
          'status',
          'studentOptionIds',
          'studentOptions',
          'updatedAt'
        ])
        && request.resource.data.id == surveyId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUidMap is map
        && request.resource.data.memberUidMap[request.auth.uid] == true
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.classId is string
        && request.resource.data.className is string
        && request.resource.data.academicYear is string
        && request.resource.data.formVersion is string
        && request.resource.data.privacyNoticeVersion is string
        && request.resource.data.studentOptionIds is list
        && request.resource.data.studentOptions is list
        && request.resource.data.studentOptionIds.size() > 0
        && request.resource.data.studentOptions.size() == request.resource.data.studentOptionIds.size()
        && request.resource.data.studentOptions.size() <= 60
        && request.resource.data.status == 'active'
        && request.resource.data.responseCount == 0
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number
        && request.resource.data.expiresAtEpochMs > request.time.toMillis();
    }

    function validStudentProfileSurveyUpdate() {
      return isStudentProfileSurveyMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expiresAt',
          'expiresAtEpochMs',
          'responseCount',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status in ['active', 'closed']
        && request.resource.data.responseCount is number
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number
        && request.resource.data.updatedAt is string;
    }

    function validStudentProfilePublicFormCreate(surveyId) {
      let survey = getAfter(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data;
      return signedIn()
        && survey.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'classId',
          'className',
          'expiresAt',
          'expiresAtEpochMs',
          'formVersion',
          'privacyNoticeVersion',
          'studentNamesById',
          'studentOptionIds',
          'studentOptions',
          'surveyId'
        ])
        && request.resource.data.surveyId == surveyId
        && request.resource.data.classId == survey.classId
        && request.resource.data.className == survey.className
        && request.resource.data.studentOptionIds == survey.studentOptionIds
        && request.resource.data.studentOptions == survey.studentOptions
        && request.resource.data.studentNamesById is map
        && request.resource.data.formVersion == survey.formVersion
        && request.resource.data.privacyNoticeVersion == survey.privacyNoticeVersion
        && request.resource.data.expiresAt == survey.expiresAt
        && request.resource.data.expiresAtEpochMs == survey.expiresAtEpochMs;
    }

    function validStudentProfilePublicFormUpdate(surveyId) {
      return canAccessStudentProfileSurveyById(surveyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'expiresAtEpochMs'])
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtEpochMs is number;
    }

    function validStudentProfileAnswerKeys(answers) {
      // Tots els camps coneguts es validen a continuació. Acceptem temporalment
      // les 58 claus de la versió anterior o les 59 actuals amb address2.
      return answers is map
        && (answers.keys().size() == 58
          || (answers.keys().size() == 59 && 'address2' in answers));
    }

    function validStudentProfilePersonalAnswers(answers) {
      return answers.birthDate is string && answers.birthDate.size() <= 20
        && answers.birthPlace is string && answers.birthPlace.size() <= 160
        && answers.address is string && answers.address.size() <= 240
        && (!('address2' in answers)
          || (answers.address2 is string && answers.address2.size() <= 240))
        && answers.parish is string && answers.parish.size() <= 80
        && answers.parishOther is string && answers.parishOther.size() <= 120
        && answers.homePhone is string && answers.homePhone.size() <= 40;
    }

    function validStudentProfileGuardianAnswers(answers) {
      return answers.guardian1Name is string && answers.guardian1Name.size() <= 160
        && answers.guardian1Relationship is string && answers.guardian1Relationship.size() <= 80
        && answers.guardian1Phone is string && answers.guardian1Phone.size() <= 40
        && answers.guardian1Profession is string && answers.guardian1Profession.size() <= 160
        && answers.guardian1Workplace is string && answers.guardian1Workplace.size() <= 160
        && answers.guardian2Name is string && answers.guardian2Name.size() <= 160
        && answers.guardian2Relationship is string && answers.guardian2Relationship.size() <= 80
        && answers.guardian2Phone is string && answers.guardian2Phone.size() <= 40
        && answers.guardian2Profession is string && answers.guardian2Profession.size() <= 160
        && answers.guardian2Workplace is string && answers.guardian2Workplace.size() <= 160;
    }

    function validStudentProfileFamilyAnswers(answers) {
      return answers.siblingCount is string && answers.siblingCount.size() <= 8
        && answers.siblingsDetails is string && answers.siblingsDetails.size() <= 600
        && answers.householdMembers is list && answers.householdMembers.size() <= 8
        && answers.householdOther is string && answers.householdOther.size() <= 240
        && answers.familyLanguages is list && answers.familyLanguages.size() <= 10
        && answers.familyLanguageOther is string && answers.familyLanguageOther.size() <= 160
        && answers.familySituation is string && answers.familySituation.size() <= 20
        && answers.familySituationDetails is string && answers.familySituationDetails.size() <= 1200;
    }

    function validStudentProfileWellbeingAnswers(answers) {
      return answers.healthSituation is string && answers.healthSituation.size() <= 20
        && answers.healthDetails is string && answers.healthDetails.size() <= 1200
        && answers.medicalPlan is string && answers.medicalPlan.size() <= 20
        && answers.medicalPlanDetails is string && answers.medicalPlanDetails.size() <= 1200
        && answers.currentSupports is list && answers.currentSupports.size() <= 10
        && answers.currentSupportOther is string && answers.currentSupportOther.size() <= 300;
    }

    function validStudentProfileSchoolAnswers(answers) {
      return answers.previousSchool is string && answers.previousSchool.size() <= 200
        && answers.previousSchoolOther is string && answers.previousSchoolOther.size() <= 240
        && answers.repeatedCourse is string && answers.repeatedCourse.size() <= 20
        && answers.repeatedCourseDetails is string && answers.repeatedCourseDetails.size() <= 240
        && answers.previousSchoolSupport is string && answers.previousSchoolSupport.size() <= 20
        && answers.schoolSupportTypes is list && answers.schoolSupportTypes.size() <= 10
        && answers.schoolSupportOther is string && answers.schoolSupportOther.size() <= 300
        && answers.hasExtracurriculars is string && answers.hasExtracurriculars.size() <= 20
        && answers.extracurricularActivities is list && answers.extracurricularActivities.size() <= 12
        && answers.hasReinforcement is string && answers.hasReinforcement.size() <= 20
        && answers.reinforcementActivities is list && answers.reinforcementActivities.size() <= 8
        && answers.middayActivities is list && answers.middayActivities.size() <= 8
        && answers.middayActivityOther is string && answers.middayActivityOther.size() <= 240
        && answers.breakPreferences is list && answers.breakPreferences.size() <= 14
        && answers.breakPreferenceOther is string && answers.breakPreferenceOther.size() <= 240
        && answers.classFriendIds is list && answers.classFriendIds.size() <= 59
        && answers.schoolFriends is string && answers.schoolFriends.size() <= 1000;
    }

    function validStudentProfileLearningAnswers(answers) {
      return answers.learningHelps is list && answers.learningHelps.size() <= 12
        && answers.learningHelpOther is string && answers.learningHelpOther.size() <= 400
        && answers.workPreferences is list && answers.workPreferences.size() <= 6
        && answers.learningChallenges is string && answers.learningChallenges.size() <= 1200
        && answers.helpSeeking is string && answers.helpSeeking.size() <= 160
        && answers.tutorExpectations is string && answers.tutorExpectations.size() <= 1200
        && answers.studentMessage is string && answers.studentMessage.size() <= 1600;
    }

    function validStudentProfileAnswers(answers) {
      return validStudentProfileAnswerKeys(answers)
        && validStudentProfilePersonalAnswers(answers)
        && validStudentProfileGuardianAnswers(answers)
        && validStudentProfileFamilyAnswers(answers)
        && validStudentProfileWellbeingAnswers(answers)
        && validStudentProfileSchoolAnswers(answers)
        && validStudentProfileLearningAnswers(answers);
    }

    function validStudentProfileResponseCreate(surveyId, responseId) {
      let survey = get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data;
      let publicForm = get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)/public/form).data;
      return activeStudentProfileSurveyById(surveyId)
        && request.resource.data.keys().hasOnly([
          'answers', 'classId', 'formVersion', 'privacyNoticeAcknowledged', 'privacyNoticeVersion',
          'reviewedAt', 'reviewedByUid', 'studentId', 'studentName', 'submittedAt', 'surveyId'
        ])
        && request.resource.data.surveyId == surveyId
        && responseId == request.resource.data.studentId
        && request.resource.data.classId == survey.classId
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.studentId in publicForm.studentOptionIds
        && request.resource.data.studentName == publicForm.studentNamesById[request.resource.data.studentId]
        && request.resource.data.formVersion == survey.formVersion
        && request.resource.data.privacyNoticeAcknowledged == true
        && request.resource.data.privacyNoticeVersion == survey.privacyNoticeVersion
        && request.resource.data.reviewedAt == ''
        && request.resource.data.reviewedByUid == ''
        && request.resource.data.submittedAt == request.time
        && validStudentProfileAnswers(request.resource.data.answers);
    }

    function validStudentProfileResponseReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedAt', 'reviewedByUid'])
        && (
          (
            request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedByUid == request.auth.uid
          )
          || (
            request.resource.data.reviewedAt == ''
            && request.resource.data.reviewedByUid == ''
          )
        );
    }

    // Suggestions are separate from teacher datasets and their backup/restore flows.
    match /feedbackMessages/{messageId} {
      function feedbackAdmin() {
        return signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'mperezc@educand.ad';
      }

      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.resource.data.keys().hasAll([
          'category', 'message', 'name', 'senderUid', 'senderEmail', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'category', 'message', 'name', 'senderUid', 'senderEmail', 'createdAt', 'status'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.category in ['suggeriment', 'dubte']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1600
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if feedbackAdmin();
      allow update: if feedbackAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'read';
      allow delete: if false;
    }

    match /teacherGradePackages/{transferId} {
      allow create: if validTeacherGradePackageCreate(transferId);

      allow read: if signedIn()
        && (
          isPackageSender()
          || isPackageRecipient()
        );

      allow update: if validTeacherGradePackageImportUpdate();

      allow delete: if isPackageSender();
    }

    match /tutoringSpaces/{spaceId} {
      allow create: if validTutoringSpaceCreate(spaceId);
      allow read: if isTutoringSpaceMember();
      allow update: if validTutoringSpaceOwnerUpdate()
        || validTutoringSpaceMemberSyncUpdate()
        || validTutoringSpaceInvitationAccept(spaceId)
        || validTutoringSpaceSelfLeave();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{collectionName}/{documentId} {
        allow read, create, update: if isAllowedTutoringCollection(collectionName)
          && canAccessTutoringSpace(spaceId);
        allow delete: if false;
      }
    }

    match /tutoringInvitationInbox/{recipientEmailLower}/items/{spaceId} {
      allow create: if validTutoringInvitationCreate(recipientEmailLower, spaceId);
      allow read: if isTutoringInvitationRecipient(recipientEmailLower) || isTutoringInvitationSender();
      allow update: if validTutoringInvitationRecipientResponse(recipientEmailLower) || validTutoringInvitationSenderAck();
      allow delete: if isTutoringInvitationRecipient(recipientEmailLower) || isTutoringInvitationSender();
    }

    match /tutoringInvitationOutbox/{senderUid}/items/{outboxId} {
      allow create: if validTutoringInvitationOutboxCreate(senderUid, outboxId);
      allow read, delete: if signedIn() && senderUid == request.auth.uid;
      allow update: if validTutoringInvitationOutboxSenderAck(senderUid)
        || validTutoringInvitationOutboxRecipientResponse();
    }

    match /sociometricSurveys/{surveyId} {
      allow create: if validSociometricSurveyCreate(surveyId);
      allow get: if canAccessSociometricSurvey();
      allow list: if false;
      allow update: if validSociometricSurveyUpdate();
      allow delete: if isSociometricSurveyOwner();

      match /accessTokens/{tokenId} {
        allow create: if validSociometricAccessTokenCreate(surveyId, tokenId);
        allow get: if validSociometricAccessTokenRead(surveyId, tokenId)
          || canAccessSociometricSurveyById(surveyId);
        allow list: if false;
        allow update: if validSociometricAccessTokenUpdate(surveyId);
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.ownerUid == request.auth.uid;
      }

      match /responses/{responseId} {
        allow create: if validSociometricResponseWrite(surveyId, responseId);
        allow get, list: if canAccessSociometricSurveyById(surveyId);
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/sociometricSurveys/$(surveyId)).data.ownerUid == request.auth.uid;
      }
    }

    match /studentProfileSurveys/{surveyId} {
      allow create: if validStudentProfileSurveyCreate(surveyId);
      allow get: if isStudentProfileSurveyMember();
      allow list: if canListStudentProfileSurvey();
      allow update: if validStudentProfileSurveyUpdate();
      allow delete: if isStudentProfileSurveyOwner();

      match /public/form {
        allow create: if validStudentProfilePublicFormCreate(surveyId);
        allow get: if activeStudentProfileSurveyById(surveyId)
          || canAccessStudentProfileSurveyById(surveyId);
        allow list: if false;
        allow update: if validStudentProfilePublicFormUpdate(surveyId);
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/studentProfileSurveys/$(surveyId)).data.ownerUid == request.auth.uid;
      }

      match /responses/{responseId} {
        allow create: if validStudentProfileResponseCreate(surveyId, responseId);
        allow get, list: if canAccessStudentProfileSurveyById(surveyId);
        allow update: if canAccessStudentProfileSurveyById(surveyId)
          && validStudentProfileResponseReviewUpdate();
        allow delete: if canAccessStudentProfileSurveyById(surveyId);
      }
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);

      match /cloudBackups/{backupId} {
        allow read, create, update, delete: if ownsUserDocument(userId);

        match /{collectionName}/{documentId} {
          allow read, create, update, delete: if ownsUserDocument(userId);
        }
      }

      match /{document=**} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }
  }
}
