rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /teacherGradePackages/{packageId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientEmailLower is string
        && request.resource.data.packageData.schema == "avaluapro.teacher-grade-package";

      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientEmailLower == request.auth.token.email
        );

      allow update, delete: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientEmailLower == request.auth.token.email
        );
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);

      match /cloudBackups/{backupId} {
        allow read, create, update, delete: if ownsUserDocument(userId);

        match /{collectionName}/{documentId} {
          allow read, create, update, delete: if ownsUserDocument(userId);
        }
      }

      match /{document=**} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }
  }
}
