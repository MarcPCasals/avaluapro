rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPackageSender() {
      return signedIn() && resource.data.senderUid == request.auth.uid;
    }

    function isPackageRecipient() {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.recipientEmailLower == request.auth.token.email;
    }

    function validTeacherGradePackageCreate(transferId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'id',
          'importedAt',
          'packageData',
          'recipientEmailLower',
          'senderEmail',
          'senderName',
          'senderUid',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == transferId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.recipientEmailLower is string
        && request.resource.data.status == 'sent'
        && request.resource.data.importedAt == ''
        && request.resource.data.packageData.schema == "avaluapro.teacher-grade-package"
        && request.resource.data.packageData.version == 1
        && request.resource.data.packageData.keys().hasOnly([
          'createdAt',
          'id',
          'schema',
          'sender',
          'source',
          'students',
          'summary',
          'version'
        ])
        && request.resource.data.packageData.id == transferId
        && request.resource.data.packageData.sender.keys().hasOnly(['email', 'name', 'uid'])
        && request.resource.data.packageData.sender.uid == request.auth.uid
        && request.resource.data.packageData.sender.email == request.auth.token.email
        && request.resource.data.packageData.source.keys().hasOnly(['classId', 'className', 'subject'])
        && request.resource.data.packageData.source.classId is string
        && request.resource.data.packageData.source.className is string
        && request.resource.data.packageData.source.subject is string
        && request.resource.data.packageData.students is list
        && request.resource.data.packageData.summary.keys().hasOnly([
          'competencyCount',
          'emptyCount',
          'gradeCount',
          'studentCount',
          'trackingStudentCount'
        ]);
    }

    function validTeacherGradePackageImportUpdate() {
      return isPackageRecipient()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'importedByEmail',
          'importedByUid',
          'importedAt',
          'status',
          'updatedAt'
        ])
        && request.resource.data.status == 'imported'
        && request.resource.data.importedByEmail == request.auth.token.email
        && request.resource.data.importedByUid == request.auth.uid
        && request.resource.data.importedAt is string
        && request.resource.data.updatedAt is string;
    }

    function isTutoringSpaceMember() {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in resource.data.memberEmails
          )
          || (
            resource.data.memberUids is list
            && request.auth.uid in resource.data.memberUids
          )
        );
    }

    function isTutoringSpaceOwner() {
      return signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.ownerEmailLower == request.auth.token.email
          )
        );
    }

    function isTutoringSpaceMemberAfterWrite() {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in request.resource.data.memberEmails
          )
          || (
            request.resource.data.memberUids is list
            && request.auth.uid in request.resource.data.memberUids
          )
        );
    }

    function canAccessTutoringSpace(spaceId) {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email in get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberEmails
          )
          || (
            get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberUids is list
            && request.auth.uid in get(/databases/$(database)/documents/tutoringSpaces/$(spaceId)).data.memberUids
          )
        );
    }

    function validTutoringSpaceCreate(spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'lastSharedConflictAt',
          'memberEmails',
          'memberUids',
          'members',
          'ownerEmailLower',
          'ownerUid',
          'sharedConflictSummary',
          'sharedSummary',
          'sourceClassId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == spaceId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmailLower == request.auth.token.email
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.auth.token.email in request.resource.data.memberEmails
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.members is list
        && request.resource.data.status == 'active';
    }

    function validTutoringSpaceUpdate() {
      return (isTutoringSpaceMember() || isTutoringSpaceOwner())
        && isTutoringSpaceMemberAfterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'className',
          'createdAt',
          'id',
          'lastSharedConflictAt',
          'memberEmails',
          'memberUids',
          'members',
          'ownerEmailLower',
          'ownerUid',
          'sharedConflictSummary',
          'sharedSummary',
          'sourceClassId',
          'status',
          'updatedAt'
        ])
        && (
          !resource.data.keys().hasAny(['id'])
          || request.resource.data.id == resource.data.id
        )
        && (
          !resource.data.keys().hasAny(['ownerUid'])
          || request.resource.data.ownerUid == resource.data.ownerUid
        )
        && (
          !resource.data.keys().hasAny(['ownerEmailLower'])
          || request.resource.data.ownerEmailLower == resource.data.ownerEmailLower
        )
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.resource.data.members is list
        && request.resource.data.status == 'active';
    }

    function hasAcceptedTutoringInvitation(spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/tutoringInvitationInbox/$(request.auth.token.email)/items/$(spaceId))
        && get(/databases/$(database)/documents/tutoringInvitationInbox/$(request.auth.token.email)/items/$(spaceId)).data.status == 'accepted';
    }

    function validTutoringSpaceInvitationAccept(spaceId) {
      return hasAcceptedTutoringInvitation(spaceId)
        && isTutoringSpaceMemberAfterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberEmails',
          'memberUids',
          'members',
          'updatedAt'
        ])
        && request.resource.data.memberEmails is list
        && request.resource.data.memberUids is list
        && request.resource.data.members is list
        && request.auth.token.email in request.resource.data.memberEmails
        && request.auth.uid in request.resource.data.memberUids;
    }

    function isTutoringInvitationRecipient(recipientEmailLower) {
      return signedIn()
        && request.auth.token.email is string
        && recipientEmailLower == request.auth.token.email;
    }

    function isTutoringInvitationSender() {
      return signedIn() && resource.data.senderUid == request.auth.uid;
    }

    function validTutoringInvitationCreate(recipientEmailLower, spaceId) {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'outboxId',
          'recipientEmailLower',
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'senderEmail',
          'senderEmailLower',
          'senderName',
          'senderSeenAt',
          'senderUid',
          'sourceClassId',
          'spaceId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == spaceId
        && request.resource.data.spaceId == spaceId
        && request.resource.data.recipientEmailLower == recipientEmailLower
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmailLower == request.auth.token.email
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == ''
        && request.resource.data.responseByEmail == ''
        && request.resource.data.responseByUid == ''
        && request.resource.data.senderSeenAt == '';
    }

    function validTutoringInvitationOutboxCreate(senderUid, outboxId) {
      return signedIn()
        && request.auth.token.email is string
        && senderUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'className',
          'createdAt',
          'id',
          'outboxId',
          'recipientEmailLower',
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'senderEmail',
          'senderEmailLower',
          'senderName',
          'senderSeenAt',
          'senderUid',
          'sourceClassId',
          'spaceId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.outboxId == outboxId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmailLower == request.auth.token.email
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.recipientEmailLower is string
        && request.resource.data.status == 'pending'
        && request.resource.data.respondedAt == ''
        && request.resource.data.responseByEmail == ''
        && request.resource.data.responseByUid == ''
        && request.resource.data.senderSeenAt == '';
    }

    function validTutoringInvitationOutboxRecipientResponse() {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.recipientEmailLower == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'status',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.responseByEmail == request.auth.token.email
        && request.resource.data.responseByUid == request.auth.uid
        && request.resource.data.respondedAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationOutboxSenderAck(senderUid) {
      return signedIn()
        && senderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'senderSeenAt',
          'updatedAt'
        ])
        && request.resource.data.senderSeenAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationRecipientResponse(recipientEmailLower) {
      return isTutoringInvitationRecipient(recipientEmailLower)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'respondedAt',
          'responseByEmail',
          'responseByUid',
          'status',
          'updatedAt'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.responseByEmail == request.auth.token.email
        && request.resource.data.responseByUid == request.auth.uid
        && request.resource.data.respondedAt is string
        && request.resource.data.updatedAt is string;
    }

    function validTutoringInvitationSenderAck() {
      return isTutoringInvitationSender()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'senderSeenAt',
          'updatedAt'
        ])
        && request.resource.data.senderSeenAt is string
        && request.resource.data.updatedAt is string;
    }

    match /teacherGradePackages/{transferId} {
      allow create: if validTeacherGradePackageCreate(transferId);

      allow read: if signedIn()
        && (
          isPackageSender()
          || isPackageRecipient()
        );

      allow update: if validTeacherGradePackageImportUpdate();

      allow delete: if isPackageSender();
    }

    match /tutoringSpaces/{spaceId} {
      allow create: if validTutoringSpaceCreate(spaceId);
      allow read: if isTutoringSpaceMember();
      allow update: if validTutoringSpaceUpdate() || validTutoringSpaceInvitationAccept(spaceId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{collectionName}/{documentId} {
        allow read, create, update, delete: if canAccessTutoringSpace(spaceId);
      }
    }

    match /tutoringInvitationInbox/{recipientEmailLower}/items/{spaceId} {
      allow create: if validTutoringInvitationCreate(recipientEmailLower, spaceId);
      allow read: if isTutoringInvitationRecipient(recipientEmailLower) || isTutoringInvitationSender();
      allow update: if validTutoringInvitationRecipientResponse(recipientEmailLower) || validTutoringInvitationSenderAck();
      allow delete: if isTutoringInvitationRecipient(recipientEmailLower) || isTutoringInvitationSender();
    }

    match /tutoringInvitationOutbox/{senderUid}/items/{outboxId} {
      allow create: if validTutoringInvitationOutboxCreate(senderUid, outboxId);
      allow read, delete: if signedIn() && senderUid == request.auth.uid;
      allow update: if validTutoringInvitationOutboxSenderAck(senderUid)
        || validTutoringInvitationOutboxRecipientResponse();
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);

      match /cloudBackups/{backupId} {
        allow read, create, update, delete: if ownsUserDocument(userId);

        match /{collectionName}/{documentId} {
          allow read, create, update, delete: if ownsUserDocument(userId);
        }
      }

      match /{document=**} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }
  }
}
