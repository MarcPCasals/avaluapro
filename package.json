    "test:purge": "bash scripts/run-sociometric-purge-tests.sh",
    "test:classroom": "node --test tests/attendance.test.js tests/classroom-tracking.test.js tests/classroom-recovery.test.js tests/agenda-today.test.js",
    "test:planning-domain": "node --test tests/planning-domain.test.js tests/planning-documents.test.js tests/planning-class-connections.test.js",
